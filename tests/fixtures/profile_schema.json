{
  "schema": {
    "additionalProperties": false,
    "description": "An engine profile's settings, by capability module (FR-PROF-2).",
    "properties": {
      "pipeline": {
        "default": "lite",
        "description": "The pipeline every turn runs: ``lite`` (FR-LITE) or ``structured`` (the Engine Core\npath).",
        "enum": [
          "lite",
          "structured"
        ],
        "title": "Pipeline",
        "type": "string"
      },
      "memory": {
        "additionalProperties": false,
        "description": "The memory modules (FR-PROF-2).",
        "properties": {
          "rolling_summary": {
            "additionalProperties": false,
            "description": "The rolling auto-summary (FR-LITE-2).",
            "properties": {
              "enabled": {
                "default": true,
                "description": "Fold messages older than the window into summary segments, and show the summary in the\nprompt.",
                "title": "Enabled",
                "type": "boolean"
              },
              "window_messages": {
                "default": 30,
                "description": "How many of the latest messages the prompt keeps verbatim.",
                "maximum": 500,
                "minimum": 1,
                "title": "Window Messages",
                "type": "integer"
              },
              "compress_threshold_tokens": {
                "default": 6000,
                "description": "The summary's size, in tokens, above which its segments are compressed further.",
                "maximum": 100000,
                "minimum": 100,
                "title": "Compress Threshold Tokens",
                "type": "integer"
              }
            },
            "title": "RollingSummary",
            "type": "object"
          },
          "episodic": {
            "additionalProperties": false,
            "description": "Episodic retrieval (FR-MEM-1, FR-RET).",
            "properties": {
              "enabled": {
                "default": false,
                "title": "Enabled",
                "type": "boolean"
              },
              "k": {
                "default": 8,
                "description": "How many memories one retrieval returns.",
                "maximum": 100,
                "minimum": 1,
                "title": "K",
                "type": "integer"
              },
              "hybrid_search": {
                "default": true,
                "description": "Run the lexical and exact-alias arms beside the vector arm (FR-RET-4).",
                "title": "Hybrid Search",
                "type": "boolean"
              },
              "reranking": {
                "default": false,
                "description": "Not delivered: ``true`` is refused (``UNDELIVERED_VALUES``).",
                "title": "Reranking",
                "type": "boolean"
              },
              "weight_similarity": {
                "default": 0.6,
                "description": "The ranking's weight on the fused similarity of the search arms (FR-RET-5).",
                "maximum": 10.0,
                "minimum": 0.0,
                "title": "Weight Similarity",
                "type": "number"
              },
              "weight_recency": {
                "default": 0.2,
                "description": "The ranking's weight on recency (decay over turns before the query's position).",
                "maximum": 10.0,
                "minimum": 0.0,
                "title": "Weight Recency",
                "type": "number"
              },
              "weight_importance": {
                "default": 0.2,
                "description": "The ranking's weight on decayed importance (FR-MEM-7).",
                "maximum": 10.0,
                "minimum": 0.0,
                "title": "Weight Importance",
                "type": "number"
              },
              "recency_half_life_turns": {
                "default": 100,
                "description": "The turns over which a memory's recency halves.",
                "maximum": 1000000,
                "minimum": 1,
                "title": "Recency Half Life Turns",
                "type": "integer"
              },
              "retrieval_token_budget": {
                "default": 3000,
                "description": "The tokens (``len // 4``) one retrieval's assembled context may hold (FR-RET-7).",
                "maximum": 200000,
                "minimum": 100,
                "title": "Retrieval Token Budget",
                "type": "integer"
              }
            },
            "title": "Episodic",
            "type": "object"
          },
          "consolidation": {
            "additionalProperties": false,
            "description": "Consolidation and reflections (FR-MEM-3,6).",
            "properties": {
              "enabled": {
                "default": false,
                "title": "Enabled",
                "type": "boolean"
              },
              "cadence_turns": {
                "default": 20,
                "description": "Turns between consolidation runs: a commit this many turns past the last consolidated\nturn starts one.",
                "maximum": 1000,
                "minimum": 1,
                "title": "Cadence Turns",
                "type": "integer"
              },
              "window_memories": {
                "default": 50,
                "description": "Uncovered episodic memories that start a consolidation run (whichever of this and\n``cadence_turns`` is reached first), and the most one window compresses.",
                "maximum": 10000,
                "minimum": 1,
                "title": "Window Memories",
                "type": "integer"
              }
            },
            "title": "Consolidation",
            "type": "object"
          },
          "hot_set": {
            "additionalProperties": false,
            "description": "The hot set of the structured pipeline's memories (FR-MEM-8, NFR-SCALE-2; #147): the\nunpinned budgets, how retirement ranks and how long an overflow may last, and which vectors\nare kept off the hot set.",
            "properties": {
              "memories_per_character": {
                "default": 2000,
                "description": "A character's unpinned hot memories (``hot_memory_budget_per_character``).",
                "maximum": 100000,
                "minimum": 1,
                "title": "Memories Per Character",
                "type": "integer"
              },
              "vectors_per_story": {
                "default": 50000,
                "description": "The story's unpinned hot vectors (``hot_vector_budget_per_story``).",
                "maximum": 10000000,
                "minimum": 1,
                "title": "Vectors Per Story",
                "type": "integer"
              },
              "importance_floor": {
                "default": 0.2,
                "description": "A memory whose decayed importance is below it is retired first, with those already\ncovered by consolidation.",
                "maximum": 1.0,
                "minimum": 0.0,
                "title": "Importance Floor",
                "type": "number"
              },
              "retirement_max_lag": {
                "default": 50,
                "description": "The committed turns an overflow episode may last: at its deadline the lowest-ranked\nuncovered memories are retired anyway (``retired_uncovered``).",
                "maximum": 100000,
                "minimum": 1,
                "title": "Retirement Max Lag",
                "type": "integer"
              },
              "retain_retired_vectors": {
                "default": false,
                "description": "Keep a retired memory's vector (and store the one its rehydration computes) instead of\ndropping it; off, a retired memory is re-embedded each time it is rehydrated.",
                "title": "Retain Retired Vectors",
                "type": "boolean"
              },
              "retain_dormant_vectors": {
                "default": false,
                "description": "Keep the vectors of a dormant or discarded continuation's memories, so a swap or an\nundo that reactivates it restores byte-identical vectors (FR-STORE-30); off, they are\ndropped and re-embedded with the story's pinned embedding model on reactivation.",
                "title": "Retain Dormant Vectors",
                "type": "boolean"
              }
            },
            "title": "HotSet",
            "type": "object"
          }
        },
        "title": "Memory",
        "type": "object"
      },
      "pins": {
        "additionalProperties": false,
        "description": "Pinned memories (FR-LITE-3): the story's author-pinned texts, always in the prompt.",
        "properties": {
          "enabled": {
            "default": true,
            "description": "Include the story's pinned memories in the prompt.",
            "title": "Enabled",
            "type": "boolean"
          },
          "max_pinned": {
            "default": 50,
            "description": "The most pinned memories a story may hold.",
            "maximum": 500,
            "minimum": 1,
            "title": "Max Pinned",
            "type": "integer"
          }
        },
        "title": "Pins",
        "type": "object"
      },
      "character_knowledge": {
        "additionalProperties": false,
        "description": "Shared context, or per-character partitions with their dials (FR-PROF-2).",
        "properties": {
          "partitions": {
            "default": false,
            "title": "Partitions",
            "type": "boolean"
          },
          "nested_beliefs": {
            "additionalProperties": false,
            "description": "Nested beliefs (FR-EPI-2, FR-BELIEF-15): off, or a depth of at least 2.",
            "properties": {
              "enabled": {
                "default": false,
                "title": "Enabled",
                "type": "boolean"
              },
              "depth": {
                "default": 2,
                "maximum": 5,
                "minimum": 2,
                "title": "Depth",
                "type": "integer"
              }
            },
            "title": "NestedBeliefs",
            "type": "object"
          },
          "lazy_resolution": {
            "default": false,
            "title": "Lazy Resolution",
            "type": "boolean"
          },
          "testimony": {
            "default": "off",
            "description": "Testimony adjudication (FR-BELIEF-3): ``model`` or ``defaulted``.",
            "enum": [
              "off",
              "model",
              "defaulted"
            ],
            "title": "Testimony",
            "type": "string"
          },
          "max_adjudications_per_turn": {
            "default": 2,
            "description": "The most ``belief_adjudication`` calls one turn makes (#162): the testimony and\nsimultaneous-conflict adjudications beyond it follow the deterministic default.",
            "maximum": 10,
            "minimum": 0,
            "title": "Max Adjudications Per Turn",
            "type": "integer"
          },
          "max_lazy_resolutions_per_turn": {
            "default": 20,
            "description": "The most pending exposures one turn resolves when a need reaches them (#164): the rest\nwait for a later need.",
            "maximum": 200,
            "minimum": 0,
            "title": "Max Lazy Resolutions Per Turn",
            "type": "integer"
          }
        },
        "title": "CharacterKnowledge",
        "type": "object"
      },
      "perception": {
        "additionalProperties": false,
        "description": "Perception routing (FR-TURN-2,9,10,13).",
        "properties": {
          "level": {
            "default": "none",
            "enum": [
              "none",
              "co_location",
              "full"
            ],
            "title": "Level",
            "type": "string"
          }
        },
        "title": "Perception",
        "type": "object"
      },
      "verification": {
        "additionalProperties": false,
        "description": "Claim verification, a ladder: off, declared claims only, plus claim extraction, plus\nentailment escalation (FR-VERIFY); and contradiction checking (FR-PROP-10).",
        "properties": {
          "level": {
            "default": "off",
            "description": "Raising it to ``extraction`` writes the claims extraction finds, so the ladder is\ndata-producing.",
            "enum": [
              "off",
              "declared",
              "extraction",
              "entailment"
            ],
            "title": "Level",
            "type": "string"
          },
          "extraction_mode": {
            "default": "gated",
            "enum": [
              "gated",
              "always"
            ],
            "title": "Extraction Mode",
            "type": "string"
          },
          "entailment_gate": {
            "default": 1.0,
            "description": "The predicate-resolution confidence below which an ``uncertain`` verdict escalates to\nthe entailment model (FR-VERIFY-3). The default, 1.0, escalates every one: the gate launches\nconservatively and is tightened per predicate shape (#155).",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Entailment Gate",
            "type": "number"
          },
          "entailment_min_confidence": {
            "default": 0.6,
            "description": "The least confidence an entailment verdict needs to count; below it the claim takes the\nsafe disposition (FR-VERIFY-8).",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Entailment Min Confidence",
            "type": "number"
          },
          "safe_disposition": {
            "default": "repair",
            "description": "What a claim the engine cannot decide becomes (FR-VERIFY-8): ``repair`` rewrites the\nsentence so it no longer asserts it, and records why; ``surface`` lets the beat stand and\nlists the claim in the turn report's ``uncertain_claims`` for the author.",
            "enum": [
              "repair",
              "surface"
            ],
            "title": "Safe Disposition",
            "type": "string"
          },
          "contradiction_checking": {
            "default": false,
            "title": "Contradiction Checking",
            "type": "boolean"
          },
          "implication_max_depth": {
            "default": 3,
            "description": "How deep the bounded implication closure goes (FR-PROP-11): ``core.verify.rules`` stops\nthere and flags the stop in the verdict's evidence.",
            "maximum": 10,
            "minimum": 1,
            "title": "Implication Max Depth",
            "type": "integer"
          }
        },
        "title": "Verification",
        "type": "object"
      },
      "commitment": {
        "additionalProperties": false,
        "description": "Commitment (FR-COMMIT) and its salience detection.",
        "properties": {
          "enabled": {
            "default": false,
            "title": "Enabled",
            "type": "boolean"
          },
          "salience": {
            "default": "rules",
            "enum": [
              "rules",
              "rules_and_model"
            ],
            "title": "Salience",
            "type": "string"
          }
        },
        "title": "Commitment",
        "type": "object"
      },
      "multi_character": {
        "additionalProperties": false,
        "description": "One combined render, or per-character renders (FR-MULTI).",
        "properties": {
          "renders": {
            "default": "combined",
            "enum": [
              "combined",
              "per_character"
            ],
            "title": "Renders",
            "type": "string"
          },
          "interjection_max_words": {
            "default": 6,
            "description": "The most words a reactive character's brief interjection may have, where the story's\n``reactive_interjections`` allows one (FR-MULTI-9; #176).",
            "maximum": 20,
            "minimum": 1,
            "title": "Interjection Max Words",
            "type": "integer"
          }
        },
        "title": "MultiCharacter",
        "type": "object"
      },
      "repair": {
        "additionalProperties": false,
        "description": "Repair and polish (FR-PROF-2).",
        "properties": {
          "max_attempts": {
            "default": 0,
            "description": "Repair attempts of the structured pipeline's repair ladder (FR-REPAIR).",
            "maximum": 10,
            "minimum": 0,
            "title": "Max Attempts",
            "type": "integer"
          },
          "implication_threshold": {
            "default": 2,
            "description": "How many rejected renders within one story may implicate a memory before it is\nquarantined automatically (FR-GUARD-5; #145). ``0`` turns auto-quarantine off. Structured\nstories only: a Lite reply's context holds no memory records.",
            "maximum": 10,
            "minimum": 0,
            "title": "Implication Threshold",
            "type": "integer"
          },
          "polish": {
            "additionalProperties": false,
            "description": "The polish pass. Under ``lite`` it is the bounded regeneration of a reply that broke an\noutput policy, before the safe fallback is used (FR-GUARD-6; M2's story setting\n``guardrail_retry_budget``, which #113 moved here). Off, a reply that breaks a policy is\nreplaced by the fallback at once. Under ``structured`` it also gates the composition's\npolish call (#152): off, a structured turn's message is the deterministic assembly of its\nchecked beats.",
            "properties": {
              "enabled": {
                "default": true,
                "title": "Enabled",
                "type": "boolean"
              },
              "max_regenerations": {
                "default": 2,
                "description": "How many times such a reply is generated again.",
                "maximum": 5,
                "minimum": 0,
                "title": "Max Regenerations",
                "type": "integer"
              }
            },
            "title": "Polish",
            "type": "object"
          }
        },
        "title": "Repair",
        "type": "object"
      },
      "render": {
        "additionalProperties": false,
        "description": "The structured pipeline's renders (FR-TURN-1; #150): how many beats one render may\nreturn, how much working memory and how large a prompt it is given.",
        "properties": {
          "max_beats": {
            "default": 6,
            "description": "The most beats one render may return (the beat schema's ``max_items``; more is invalid\nstructure, which the model retries). #156's budget planning reuses it.",
            "maximum": 20,
            "minimum": 1,
            "title": "Max Beats",
            "type": "integer"
          },
          "working_memory_beats": {
            "default": 20,
            "description": "How many of the latest beats the rendering character's working memory holds (FR-MEM-5).",
            "maximum": 200,
            "minimum": 1,
            "title": "Working Memory Beats",
            "type": "integer"
          },
          "prompt_token_budget": {
            "default": 6000,
            "description": "The structured prompt's cap in tokens (``len // 4``): retrieved context is trimmed first,\nthen working memory.",
            "maximum": 200000,
            "minimum": 500,
            "title": "Prompt Token Budget",
            "type": "integer"
          }
        },
        "title": "Render",
        "type": "object"
      },
      "budgets": {
        "additionalProperties": false,
        "description": "The per-turn model-call budget and deadline (NFR-PERF-6).",
        "properties": {
          "model_calls": {
            "anyOf": [
              {
                "maximum": 50,
                "minimum": 1,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "The most model calls one turn may make, the reserved guardrail calls included (M2's\n``max_model_calls_per_turn``, which #113 moved here): a cap below one generation plus those\ncalls refuses every turn. ``null``: NFR-PERF-6's formula (9 + the guardrail calls in M3).",
            "title": "Model Calls"
          },
          "deadline_ms": {
            "default": 45000,
            "description": "A turn's wall-clock deadline, in milliseconds (M2's ``turn_deadline``, in seconds, which\n#113 moved here); the turn slot's lease and a queued request's wait follow it.",
            "maximum": 600000,
            "minimum": 1,
            "title": "Deadline Ms",
            "type": "integer"
          }
        },
        "title": "Budgets",
        "type": "object"
      },
      "models": {
        "additionalProperties": false,
        "description": "Per-purpose model routing (FR-MODEL) and the generation defaults.",
        "properties": {
          "purposes": {
            "description": "Routing by purpose; a purpose left out inherits the deployment's configuration.",
            "maxProperties": 50,
            "patternProperties": {
              "^[a-z][a-z0-9_]{0,63}$": {
                "additionalProperties": false,
                "description": "One model purpose's routing: its model and parameters; ``null`` inherits from the\ndeployment's model configuration (``/admin/model-config``). Endpoints and keys are never\npart of a profile.",
                "properties": {
                  "model": {
                    "anyOf": [
                      {
                        "maxLength": 200,
                        "minLength": 1,
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "default": null,
                    "title": "Model"
                  },
                  "params": {
                    "anyOf": [
                      {
                        "additionalProperties": false,
                        "description": "Generation parameters for one purpose's calls; ``null`` inherits.",
                        "properties": {
                          "temperature": {
                            "anyOf": [
                              {
                                "maximum": 2.0,
                                "minimum": 0.0,
                                "type": "number"
                              },
                              {
                                "type": "null"
                              }
                            ],
                            "default": null,
                            "title": "Temperature"
                          },
                          "top_p": {
                            "anyOf": [
                              {
                                "maximum": 1.0,
                                "minimum": 0.0,
                                "type": "number"
                              },
                              {
                                "type": "null"
                              }
                            ],
                            "default": null,
                            "title": "Top P"
                          },
                          "max_tokens": {
                            "anyOf": [
                              {
                                "maximum": 4000,
                                "minimum": 1,
                                "type": "integer"
                              },
                              {
                                "type": "null"
                              }
                            ],
                            "default": null,
                            "title": "Max Tokens"
                          }
                        },
                        "title": "RouteParams",
                        "type": "object"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "default": null
                  }
                },
                "title": "PurposeRoute",
                "type": "object"
              }
            },
            "title": "Purposes",
            "type": "object",
            "additionalProperties": false
          },
          "generation": {
            "additionalProperties": false,
            "description": "The generation defaults (FR-LITE-4): temperature, top_p and response length.",
            "properties": {
              "temperature": {
                "anyOf": [
                  {
                    "maximum": 2.0,
                    "minimum": 0.0,
                    "type": "number"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": 0.8,
                "title": "Temperature"
              },
              "top_p": {
                "anyOf": [
                  {
                    "maximum": 1.0,
                    "minimum": 0.0,
                    "type": "number"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": 0.95,
                "title": "Top P"
              },
              "response_length": {
                "anyOf": [
                  {
                    "enum": [
                      "short",
                      "medium",
                      "long"
                    ],
                    "type": "string"
                  },
                  {
                    "maximum": 4000,
                    "minimum": 1,
                    "type": "integer"
                  }
                ],
                "default": "medium",
                "description": "``short``, ``medium``, ``long``, or a token cap.",
                "title": "Response Length"
              }
            },
            "title": "Generation",
            "type": "object"
          }
        },
        "title": "Models",
        "type": "object"
      }
    },
    "title": "ProfileSettings",
    "type": "object"
  },
